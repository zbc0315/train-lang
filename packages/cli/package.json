{
  "name": "@tom2012/train-cli",
  "version": "0.1.0",
  "description": "train language CLI — run/check/version/help",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "bin": {
    "train": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@tom2012/train-core": "workspace:*",
    "@tom2012/train-adapter-spec": "workspace:*",
    "@tom2012/train-adapter-mock": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "execa": "^9.5.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
